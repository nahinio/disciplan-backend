# ── Application ──────────────────────────────────────────────
APP_NAME=DisciPlan API
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ── Aiven MySQL ──────────────────────────────────────────────
# From Aiven Console → MySQL service → Connection information
DB_HOST=your-service.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your_password
DB_NAME=defaultdb
# Set true for Aiven (required). Download CA from Aiven console.
DB_SSL=true
DB_SSL_CA_PATH=./certs/ca.pem
# Render/production: paste full PEM here instead of using a file path
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── JWT Auth ─────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OTP (signup) ─────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
# Set false in production; when true, OTP is always OTP_DEMO_CODE (local dev only)
OTP_DEMO_MODE=true
OTP_DEMO_CODE=123456

# ── Bootstrap scripts (optional, not auto-run) ───────────────
# BOOTSTRAP_ADMIN_EMAIL=admin@uiu.ac.bd
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Administrator
# BOOTSTRAP_FACULTY_EMAIL=faculty@uiu.ac.bd
# BOOTSTRAP_FACULTY_PASSWORD=
# BOOTSTRAP_FACULTY_NAME=Faculty Name
# BOOTSTRAP_FACULTY_ROSTER_ONLY=false

# ── Cloudinary (file storage) ────────────────────────────────
# Cloud name is on Dashboard → Product environment credentials (e.g. dxxxxxxxx)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=disciplan

# ── Polling hints (documented for frontend) ──────────────────
NOTIFICATION_POLL_INTERVAL_SEC=8
CHAT_POLL_INTERVAL_SEC=3
